{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slot-model:game-config:1",
  "title": "Slot Game Configuration",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "config_type",
    "schema_version",
    "game",
    "symbols",
    "reels",
    "paylines"
  ],

  "properties": {
    "config_type": {
      "const": "slot_game"
    },

    "schema_version": {
      "const": 1
    },

    "game": {
      "$ref": "#/$defs/game"
    },

    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },

    "reels": {
      "$ref": "#/$defs/reels"
    },

    "paylines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payline"
      }
    },

    "ui": {
      "$ref": "#/$defs/ui"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },

    "hex_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },

    "game": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "name",
        "rows",
        "reel_count",
        "window_offsets"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "rows": {
          "type": "integer",
          "minimum": 1
        },

        "reel_count": {
          "type": "integer",
          "minimum": 1
        },

        "window_offsets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        }
      }
    },

    "symbol": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "name",
        "kind"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "kind": {
          "enum": [
            "regular",
            "wild",
            "scatter",
            "bonus"
          ]
        },

        "substitutes_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },

    "reels": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "active_set",
        "sets"
      ],

      "properties": {
        "active_set": {
          "$ref": "#/$defs/identifier"
        },

        "sets": {
          "type": "object",
          "minProperties": 1,

          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },

          "additionalProperties": {
            "$ref": "#/$defs/reel_set"
          }
        }
      }
    },

    "reel_set": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "strips"
      ],

      "properties": {
        "description": {
          "type": "string"
        },

        "strips": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "array",
            "minItems": 1,

            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },

    "payline": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "name",
        "rows"
      ],

      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "rows": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },

    "payline_style": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "color": {
          "$ref": "#/$defs/hex_color"
        },

        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },

    "symbol_style": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "label": {
          "type": "string"
        },

        "foreground": {
          "$ref": "#/$defs/hex_color"
        },

        "background": {
          "$ref": "#/$defs/hex_color"
        }
      }
    },

    "ui": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "paylines": {
          "type": "object",

          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },

          "additionalProperties": {
            "$ref": "#/$defs/payline_style"
          }
        },

        "symbols": {
          "type": "object",

          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },

          "additionalProperties": {
            "$ref": "#/$defs/symbol_style"
          }
        }
      }
    }
  }
}